# Mempalace generated files (not for version control)
entities.json
mempalace.yaml
# ...but the mneme authority IS version-controlled — the bare `mempalace.yaml`
# rule above (a legacy-mempalace wing-config rule) matches in every dir and would
# otherwise swallow it, silently dropping bring-up on the floor. See toee/.mneme.
!.mneme/mempalace.yaml
MEMPALACE.md

# Operational / local
logs/
.claude/

# OS / system files
desktop.ini
*.Zone.Identifier
*:com.dropbox.attrs
gMarkdown
gdrive

# Operational artifacts leaked into repo root (should live outside the repo)
/abyss/
/docs/.cg/

# UI runtime state + migration artifacts (regenerable)
ui_state.yaml
ui_config.yaml.migrated

# 5etools ingest cache
docs/background/.fivetools_ingest/

# scratch
.playwright-mcp
scratch/

# Entity-triage transient queue files (regenerated per run). NOTE: the state file
# docs/.entity_triage_state.json IS version-controlled on purpose, so the GM
# "don't re-ask" decisions (ignored/deferred) travel across machines.
docs/.triage_queue*.json

# Source PDFs for character-sheet conversions (raw D&D Beyond exports; the
# converted .md under docs/party/ is the versioned artifact, not the PDF)
docs/party/old/*.pdf
docs/background/.module_inventory/
docs/background/.spell_canon/

# Raw Zoom session audio (tens of MB per session, past GitHub's comfortable
# blob size and no LFS here). Same rule as the PDFs above: the transcript .vtt
# is the versioned artifact, the recording it was made from is not.
summaries/**/*.m4a

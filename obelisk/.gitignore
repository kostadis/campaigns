# Mempalace generated entity index — regenerated by `mempalace init`, not source.
# Root-anchored on purpose. Deliberately NOT accompanied by a bare
# `mempalace.yaml` rule the way out-of-the-abyss does it: obelisk tracks both
# mempalace.yaml and .mneme/mempalace.yaml, and an unanchored rule matches at
# every depth, so it would silently swallow the .mneme authority.
/entities.json

# module-inventory skill working directory (transient, regenerable)
docs/background/.module_inventory/

# entity-triage skill state (transient, local)
docs/.entity_triage_state.json
docs/.triage_queue.json

# Operational / local
.claude/

# Session audio — recordings stay local; the repo tracks transcripts, not media.
*.m4a
*.mp3
*.wav

# Narration snapshot tarballs (regenerable build artifacts)
summaries/*/session-nar.tar

# CampaignGenerator activity telemetry (transient, local)
summaries/*/.cg/

# entity-triage transients (local)
docs/.triage_queue.json
docs/.entity_triage_state.json

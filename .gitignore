# Windows NTFS "downloaded from browser" metadata streams
*:Zone.Identifier

# Accidental symlinks to filesystem mount points
/mnt
/wsl

# Per-campaign MCP config — contains literal ANTHROPIC_API_KEY
.mcp.json

# Per-machine campaign root paths (self-declared git-ignored)
refs.local.yaml

# MemPalace index/cache directories (regenerable, not source)
.mempalace/

# tokensave MCP index/cache (regenerable, not source). Unanchored on purpose:
# the server writes its SQLite db + WAL into whichever campaign dir it runs in.
.tokensave/

# Stray CampaignGenerator server logs from running the tool at the repo root
# instead of inside a campaign dir. Root-scoped on purpose: a bare `logs/` would
# match at any depth and silently stop toee's version-controlled pipeline run
# records (logs/*_scene_extract.md et al) from ever being added. Per-campaign log
# policy stays per-campaign — see out-of-the-abyss/.gitignore.
/logs/
